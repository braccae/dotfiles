# ==============================================================================
# Default: Ignore all files and directories (both visible and hidden)
# ==============================================================================
/*
/.*

# ==============================================================================
# Allow Gitignore Itself
# ==============================================================================
!.gitignore

# ==============================================================================
# Whitelist Shell Configuration Dotfiles
# ==============================================================================

# POSIX / General Shell Dotfiles
!.profile
!.inputrc
!.aliases
!.exports
!.functions
!.shellrc
!.shrc

# Bash Dotfiles
!.bashrc
!.bash_profile
!.bash_login
!.bash_logout
!.bash_aliases
!.bash_functions

# Zsh Dotfiles
!.zshrc
!.zshenv
!.zprofile
!.zlogin
!.zlogout
!.p10k.zsh

# Optional: Shell prompt & tool configs (uncomment if desired)
# !.starship.toml
# !.dircolors

# ==============================================================================
# Defense-in-Depth: Explicit Secrets, History & Cache Exclusion Rules
# (Ensures accidental pattern additions never leak credentials)
# ==============================================================================

# Command History & Session Dumps (contain passwords, API keys, bearer tokens)
.bash_history
.zsh_history
.sh_history
.python_history
.node_repl_history
.mysql_history
.psql_history
.lesshst
.viminfo
.zsh_sessions/
.zcompdump*
*.zwc

# Cryptographic Keys, Certificates & Credentials
.ssh/
.gnupg/
.netrc
.auth/
auth
.credentials*
.secrets/
*.pem
*.key
*.pub
*.p12
*.pfx
*.crt
*.cer
*.kdbx

# Cloud, Container & Tool Auth Configurations
.aws/
.kube/
.docker/
.oci/
.mcp-auth/
.gemini/
.claude/
.azure/
.gcloud/

# Environment Files & Tokens
.env
.env.*
.env*.local
!.env.example
*.token
*.secret
*.pass
*.password

# Backup & Editor Artifacts
*.bak
*.old
*.swp
*.swo
*~
*.pre-oh-my-zsh
